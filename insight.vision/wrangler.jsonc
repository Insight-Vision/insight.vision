{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insight-vision",
  "account_id": "230005c56e2e3516f066a603a731ac83",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
